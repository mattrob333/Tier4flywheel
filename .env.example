# Airtable Personal Access Token (create at https://airtable.com/create/tokens)
AIRTABLE_PAT=

# Airtable Base ID (the appXXXXXXXXX part of your base URL)
AIRTABLE_BASE_ID=

# Airtable table name
AIRTABLE_TABLE_NAME=

# OpenAI Responses API key for the internal advisor audit tool.
# Server only. Do not expose this as VITE_* or NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional model overrides for the advisor audit tool.
OPENAI_AUDIT_MODEL=gpt-5.5
OPENAI_AUDIT_REPORT_MODEL=gpt-5.5

# Clerk auth for /admin/audit.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Password gate before Clerk. Generate a long random cookie secret for production.
ADVISOR_GATE_PASSWORD=tier4 2026
ADVISOR_GATE_COOKIE_SECRET=

# Optional Clerk/team restrictions. Use one or more before production.
CLERK_ALLOWED_ORG_ID=
CLERK_AUTHORIZED_PARTIES=https://tier4intelligence.com,https://www.tier4intelligence.com
AUDIT_ALLOWED_EMAIL_DOMAINS=tier4intelligence.com,tier4advisors.com
AUDIT_ALLOWED_EMAILS=
AUDIT_SUPERUSER_EMAILS=

# Server-only Supabase audit history storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only bypass for UI/API testing before Clerk is configured.
# Do not set this to true in production.
VITE_AUDIT_AUTH_BYPASS=false
AUDIT_AUTH_BYPASS=false
