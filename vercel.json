{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.clerk.accounts.dev https://*.clerk.com https://*.clerk.services https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.googletagmanager.com https://*.clerk.accounts.dev https://*.clerk.com https://*.clerk.services; frame-src https://www.googletagmanager.com https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://tier4intelligence.com https://www.tier4intelligence.com; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/(.*)",
      "destination": "/docs/$1"
    },
    {
      "source": "/((?!api/|docs/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/lead.js": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/report.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/audit-research.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-report.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-report-chunk.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-report-evidence.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-readout-guide.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-readout-transcript.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/audit-proposal.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/audit-followup.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/advisor-audits.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/advisor-gate/index.js": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/advisor-gate/status.js": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/advisor-gate/logout.js": {
      "maxDuration": 10,
      "memory": 512
    }
  }
}
